    "email": "nick.richardson@mediapixeldesign.com"
  },
  "keywords": [
    "angular",
    "angular2",
    "hotkeys",
    "keyboard",
    "shortcut"
  ],
  "bugs": {
    "url": "https://github.com/Yuri-Lima/angular2-hotkeys/issues"
  },
  "sideEffects": false,
  "dependencies": {
    "mousetrap": "^1.6.5",
    "tslib": "^2.8.0"
  },
